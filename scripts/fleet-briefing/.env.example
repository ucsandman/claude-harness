# Fleet briefing config — copy to .env and fill in.
# Provider tokens (VERCEL_TOKEN, GITHUB_TOKEN, STRIPE_LIVE_SECRET_KEY,
# SENTRY_AUTH_TOKEN, TWILIO_AUTH_TOKEN) come from the machine secrets wiring;
# only briefing-specific values live here.

# Twilio SMS (leave blank to run board-only)
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
BRIEFING_SMS_TO=+1XXXXXXXXXX

# daily = text every morning; anomaly = text only when something is red
BRIEFING_SMS_POLICY=daily

# Link appended to the SMS (the published board URL)
BRIEFING_BOARD_URL=
