# Mirror repo: plain deny-list. The private origin uses an ignore-everything
# allowlist (/* + !re-includes); that style silently dropped README and LICENSE
# from this mirror's first commit, so the mirror inverts it. Per-tool runtime
# output is handled by each tools/*/.gitignore.

# Never these, anywhere
.secrets.env
keys/
.credentials.json
*.pem
*.key

# Script runtime output and state
scripts/*/.env
scripts/*/out/
scripts/*/run.log
scripts/*/state.json
scripts/*/history.jsonl
scripts/**/__pycache__/

# Caches and per-session state
__pycache__/
.ruff_cache/
hooks/.fable-spawn-counts.json
