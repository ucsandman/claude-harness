{
  "env": {
    "DASHCLAW_BEHAVIOR_SAMPLES_ENABLED": "1",
    "DASHCLAW_BEHAVIOR_SAMPLES_DIR": "C:/Users/sandm/.dashclaw/behavior-samples",
    "BASH_ENV": "/c/Users/sandm/.claude/load-secrets.sh"
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(pnpm typecheck)",
      "Bash(npm view *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_screenshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__take_snapshot",
      "mcp__plugin_chrome-devtools-mcp_chrome-devtools__list_console_messages",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_stripe_stripe__stripe_api_read",
      "mcp__plugin_stripe_stripe__get_stripe_account_info",
      "mcp__plugin_stripe_stripe__search_stripe_resources",
      "mcp__plugin_vercel_vercel__get_project"
    ],
    "deny": [
      "Read(**/.secrets.env)",
      "Bash(rm -rf /:*)",
      "Bash(rm -fr /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -fr ~:*)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/secret-guard.cjs\"",
            "timeout": 5,
            "statusMessage": "Scanning for secrets..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "repowise-rewrite",
            "timeout": 5,
            "statusMessage": "Distilling command output..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5,
            "statusMessage": "rtk: compressing command..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/dev-server-guard.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking dev-server hygiene..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/process-kill-guard.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking process-kill safety..."
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/agent-model-guard.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking subagent model routing..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/scope-lock.cjs\"",
            "timeout": 5,
            "statusMessage": "Checking scope lock..."
          }
        ]
      },
      {
        "matcher": "Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Projects/DashClaw/hooks/dashclaw_pretool.py\" --agent-id claude-code",
            "timeout": 3660,
            "statusMessage": "DashClaw guard check..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskStop",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/dev-server-guard.cjs\"",
            "timeout": 5,
            "statusMessage": "Dev-server teardown reminder..."
          }
        ]
      },
      {
        "matcher": "Agent|Task|Bash|PowerShell|Edit|Write|MultiEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Projects/DashClaw/hooks/dashclaw_posttool.py\" --agent-id claude-code"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Projects/DashClaw/hooks/dashclaw_stop.py\" --agent-id claude-code"
          },
          {
            "type": "command",
            "command": "python \"C:/Users/sandm/.claude/hooks/sync-main-checkout.py\""
          },
          {
            "type": "command",
            "command": "python \"C:/Users/sandm/.claude/hooks/skill-telemetry.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Projects/DashClaw/hooks/enforcement_liveness_probe.py\" --agent-id claude-code --source session-start",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python \"C:/Users/sandm/.claude/hooks/session-count.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/opus-handoff-inject.cjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"C:/Users/sandm/.claude/hooks/context-nudge.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/scope-lock.cjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"C:/Users/sandm/.claude/hooks/opus-handoff-inject.cjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
